# Copy this file to ".env" and fill in your values. Never commit ".env".

# Google Gemini API key. Get one at https://aistudio.google.com/apikey
# Leave empty to run in demo mode (answers are quoted from the knowledge base, no LLM).
GEMINI_API_KEY=

# Gemini model used to generate answers.
GEMINI_MODEL=gemini-3.5-flash

# Embeddings: "auto" (ONNX MiniLM, falls back to "hash" if unavailable), "onnx", or "hash".
EMBEDDING_BACKEND=auto

# Optional overrides
# RETRIEVAL_TOP_K=4
# MIN_RELEVANCE=0.31
# API_HOST=127.0.0.1
# API_PORT=8000
# LOG_LEVEL=INFO
